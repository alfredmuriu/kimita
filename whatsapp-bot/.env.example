# Copy to .env and fill in. Never commit the real .env.

# The deployed customer-bot bridge endpoint (your production site).
CHAT_API_URL=https://www.agrikima.co.ke/api/whatsapp/bridge

# Must match AGENT_CRON_SECRET in the Vercel project — this is how the bot
# authenticates to /api/chat (the middleware accepts this header).
AGENT_CRON_SECRET=

# Optional but recommended: comma-separated WhatsApp numbers allowed to talk to
# the bot (digits only, country code, no +). Leave empty to reply to everyone.
# Example: 254712345678,254700111222
ALLOWED_NUMBERS=
