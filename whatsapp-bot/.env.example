# Agrikima WhatsApp bridge (Baileys) — copy to .env on the VPS and fill in.
#   cp .env.example .env && nano .env

# The deployed customer-brain endpoint. Leave as-is unless testing locally.
CHAT_API_URL=https://www.agrikima.co.ke/api/whatsapp/bridge

# Must match AGENT_CRON_SECRET in Vercel exactly, or every reply fails with 401.
# Copy the value from Vercel → Settings → Environment Variables. Don't commit it.
AGENT_CRON_SECRET=

# Who the bot answers: comma-separated digits, country code, no '+'.
# Leave BLANK to answer everyone — set it while testing so strangers don't hit
# the bot before you're ready.
# e.g. ALLOWED_NUMBERS=254712345678,254790600972
ALLOWED_NUMBERS=

# Optional. Liveness ping target; defaults to CHAT_API_URL with /bridge swapped
# for /heartbeat, which is correct in production. Only set this to override.
# HEARTBEAT_URL=https://www.agrikima.co.ke/api/whatsapp/heartbeat
